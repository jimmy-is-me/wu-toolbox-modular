#: premium-files/guests/functions-guest-emails.php:321
#: includes/admin/settings/guest-customers-tab__premium_only.php:43
#, fuzzy, php-format
msgid ""
"<p>Hi there,</p>\n"
"<p>We noticed you've been shopping with us! You've earned <strong>"
"{total_points} {points_label}</strong> from your purchases.</p>\n"
"<p>Create a free account to claim your %1$s and start redeeming amazing "
"rewards.</p>\n"
"<p><a href=\"{register_url}\" style=\"display:inline-block;background:"
"#667eea;color:#fff;padding:12px 24px;border-radius:5px;text-decoration:none;"
"font-weight:600;\">Create Account &amp; Claim %1$s</a></p>\n"
"<p>Here's a summary of your %2$s:</p>\n"
"<ul>\n"
"<li>Total %1$s earned: <strong>{total_points}</strong></li>\n"
"<li>Number of orders: <strong>{total_orders}</strong></li>\n"
"</ul>\n"
"<p>Don't miss out – your %2$s are waiting!</p>\n"
"<p>Thanks,<br>{site_name}</p>"
msgstr ""
"<p>Hola,</p>\n"
"<p>¡Nos hemos dado cuenta de que has estado comprando con nosotros! Has "
"ganado <strong>{total_de_puntos} {points_label}</strong> con tus compras.</p>"
"\n"
"<p>Crea una cuenta gratuita para reclamar tus %1$s y empezar a canjear "
"increíbles recompensas.</p>\n"
"<p><a href=\"{register_url}\" style=\"display:inline-block;background:"
"#667eea;color:#fff;padding:12px 24px;border-radius:5px;text-decoration:none;"
"font-weight:600;\">Crea una cuenta y reclama %1$s</a></p> <p>\n"
"<p>Aquí tienes un resumen de tus %2$s:</p>\n"
"<ul>\n"
"<li>Total %1$s ganado: <strong>{total_puntos}</strong></li>\n"
"<li>Número de pedidos: <strong>{total_pedidos}</strong></li>\n"
"</ul>\n"
"<p>¡No te lo pierdas: tus %2$s están esperando!</p>\n"
"<p>Gracias,<br>{nombre_del_sitio}</p>"

