#: premium-files/functions-points-expiry.php:346
#, fuzzy
msgid ""
"<p>Hi {user_name},</p>\n"
"\n"
"<p>This is a friendly reminder that your {points_label} balance of <strong>"
"{total_points}</strong> will expire on <strong>{expiry_date}</strong> due to "
"inactivity.</p>\n"
"\n"
"<p>Earn new points within the next {days_until_expiry} days to keep your "
"balance active.</p>\n"
"\n"
"<p><a href=\"{rewards_url}\">Visit your rewards dashboard</a> to keep "
"earning and redeeming.</p>\n"
"\n"
"<p>Thanks,<br>{site_name}</p>"
